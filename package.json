{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/test_circuits.ts && tsx scripts/test_park_progress.ts && tsx scripts/test_theme_content.ts && tsx scripts/audit_theme.ts && tsx scripts/test_hint_engine.ts && tsx scripts/audit-rules.ts && tsx scripts/test_phase0_spec.ts && tsx scripts/test_phase0_burden.ts && tsx scripts/audit-phase0.ts && tsx scripts/test_chapter1.ts && tsx scripts/test_chapter2.ts && tsx scripts/test_chapter3.ts",
    "test:ui": "tsx scripts/test_park_ui.ts && tsx scripts/test_park_star_upgrade.ts && tsx scripts/test_park_victory_layout.ts",
    "test:pipes": "python scripts/audit_pipe_ports.py && tsx scripts/test_pipe_alignment.ts",
    "test:merge": "tsx scripts/test_master_merge.ts",
    "test:theme": "tsx scripts/test_theme_content.ts && tsx scripts/audit_theme.ts",
    "lab:par": "tsx scripts/lab-par.ts",
    "lab:play": "node scripts/lab-playthrough.mjs",
    "lab:gear": "tsx scripts/gear-gen.ts",
    "audit:theme": "tsx scripts/audit_theme.ts",
    "audit:levels": "tsx scripts/solve-min-par.ts && tsx scripts/audit-difficulty.ts",
    "audit:rules": "tsx scripts/audit-rules.ts",
    "audit:phase0": "tsx scripts/audit-phase0.ts",
    "audit:chapter1": "tsx scripts/test_chapter1.ts && tsx scripts/audit-chapter1.ts",
    "audit:chapter2": "tsx scripts/test_chapter2.ts && tsx scripts/audit-chapter2.ts",
    "audit:chapter3": "tsx scripts/test_chapter3.ts && tsx scripts/audit-chapter3.ts",
    "chapter1:gen": "tsx scripts/chapter1-gen.ts --write",
    "chapter2:gen": "tsx scripts/chapter2-gen.ts --write",
    "chapter3:gen": "tsx scripts/chapter3-gen.ts --write",
    "test:phase0": "tsx scripts/test_phase0_spec.ts && tsx scripts/test_phase0_burden.ts && tsx scripts/lab-par.ts",
    "playtest:phase0": "tsx scripts/phase0-playthrough.ts",
    "baseline:levels": "tsx scripts/baseline-level-layout.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.65.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
